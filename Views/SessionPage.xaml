<Page x:Class="JulesClient.Views.SessionsPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:JulesClient.Models"
    xmlns:vm="using:JulesClient.ViewModels"
    xmlns:converters="using:JulesClient.Services"
    xmlns:svc="using:JulesClient.Services"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:OriginatorToBubbleStyleConverter x:Key="OriginatorToBubbleStyleConverter"/>
        <converters:OriginatorToLabelConverter x:Key="OriginatorToLabelConverter"/>
        <converters:Base64ToImageSourceConverter x:Key="Base64ToImageSourceConverter"/>
        <converters:DateTimeToTimeConverter x:Key="DateTimeToTimeConverter"/>
        <converters:DiffLineTypeToColorConverter x:Key="DiffLineTypeToColorConverter"/>
        <converters:DiffLineTypeToForegroundConverter x:Key="DiffLineTypeToForegroundConverter"/>

        <SolidColorBrush x:Key="DiffAddedBrush" Color="#3FB950"/>
        <SolidColorBrush x:Key="DiffRemovedBrush" Color="#F85149"/>

        <DataTemplate x:Key="ArtifactsTemplate" x:DataType="models:Artifact">
            <StackPanel Margin="0,1,0,0">
                <!-- Bash Output: Minimalist rendering -->
                <StackPanel Margin="0,1" Padding="8,4" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" CornerRadius="4"
                            Visibility="{x:Bind BashOutput.HasData, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                    <TextBlock Text="{x:Bind BashOutput.Output, Mode=OneWay}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Opacity="0.9"/>
                </StackPanel>

                <!-- Pull Request: Single-line hyperlink -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1"
                            Visibility="{x:Bind PullRequest.HasData, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                    <SymbolIcon Symbol="Link" Foreground="{ThemeResource SystemAccentColor}" Width="16" Height="16"/>
                    <HyperlinkButton Content="{x:Bind PullRequest.Title, Mode=OneWay}" NavigateUri="{x:Bind PullRequest.Url, Mode=OneWay}" Padding="0" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Media: Compact scale -->
                <Image Source="{x:Bind Media.Data, Converter={StaticResource Base64ToImageSourceConverter}, Mode=OneWay}"
                        Visibility="{x:Bind Media.HasData, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"
                        MaxHeight="250" Stretch="Uniform" Margin="0,2" HorizontalAlignment="Left"/>
            </StackPanel>
        </DataTemplate>

        <!-- Progress update section (title + markdown body) -->
        <DataTemplate x:Key="ProgressSectionTemplate" x:DataType="models:Activity">
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind ProgressUpdated.Title, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="15" FontFamily="Segoe UI Variable Display, Segoe UI"
                           Visibility="{x:Bind ProgressUpdated.Title, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}"/>
                <svc:MarkdownPresenter Markdown="{x:Bind ProgressUpdated.Description, Mode=OneWay}" BaseFontSize="14" Opacity="0.9"
                           Visibility="{x:Bind ProgressUpdated.Description, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Proposed plan section (heading + title + body + steps) -->
        <DataTemplate x:Key="PlanSectionTemplate" x:DataType="models:Activity">
            <StackPanel Spacing="4">
                <TextBlock Text="Proposed Plan" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="12" CharacterSpacing="40" Margin="0,0,0,1"/>
                <TextBlock Text="{x:Bind PlanGenerated.Plan.Title, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="15" FontFamily="Segoe UI Variable Display, Segoe UI"
                           Visibility="{x:Bind PlanGenerated.Plan.Title, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}"/>
                <svc:MarkdownPresenter Markdown="{x:Bind PlanGenerated.Plan.Description, Mode=OneWay}" BaseFontSize="14" Opacity="0.9"
                           Visibility="{x:Bind PlanGenerated.Plan.Description, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}"/>
                <ItemsControl ItemsSource="{x:Bind PlanGenerated.Plan.Steps, Mode=OneWay}" Margin="0,4,0,0"
                              Visibility="{x:Bind PlanGenerated.Plan.Steps, Converter={StaticResource CollectionToVisibilityConverter}, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:PlanStep">
                            <Grid Margin="0,3,0,0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="6" Height="6" Margin="0,7,0,0" VerticalAlignment="Top" Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                    <svc:MarkdownPresenter Markdown="{x:Bind Description, Mode=OneWay}" BaseFontSize="12" Opacity="0.8"
                                               Visibility="{x:Bind Description, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- Session failure callout -->
        <DataTemplate x:Key="FailedSectionTemplate" x:DataType="models:Activity">
            <Border Padding="12" CornerRadius="8" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCriticalBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <SymbolIcon Symbol="Important" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Top"/>
                    <StackPanel>
                        <TextBlock Text="Session failed" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="14"/>
                        <TextBlock Text="{x:Bind SessionFailed.Reason, Mode=OneWay}" TextWrapping="Wrap" FontSize="13" Opacity="0.9" IsTextSelectionEnabled="True"
                                   Visibility="{x:Bind SessionFailed.Reason, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Per-message raw JSON, shown only when Verbose logging is on (Settings > Diagnostics) -->
        <DataTemplate x:Key="RawJsonTemplate" x:DataType="models:Activity">
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False" Margin="0,4,0,0"
                      svc:ScrollAnchor.PreserveOnResize="True"
                      Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <Expander.Header>
                    <TextBlock Text="Raw JSON" FontSize="10" FontWeight="Bold" Opacity="0.6" CharacterSpacing="30"/>
                </Expander.Header>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                              VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled" MaxHeight="320">
                    <TextBox Text="{x:Bind RawInfo, Mode=OneWay}" IsReadOnly="True" IsSpellCheckEnabled="False"
                             FontFamily="Consolas, Cascadia Mono, Courier New" FontSize="11"
                             TextWrapping="NoWrap" AcceptsReturn="True" BorderThickness="0"
                             Background="Transparent"/>
                </ScrollViewer>
            </Expander>
        </DataTemplate>

        <DataTemplate x:Key="DefaultMessageTemplate" x:DataType="models:Activity">
            <Grid Margin="16,2" Visibility="{x:Bind HasContent, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                <Border Style="{x:Bind EffectiveOriginator, Converter={StaticResource OriginatorToBubbleStyleConverter}}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind EffectiveOriginator, Converter={StaticResource OriginatorToLabelConverter}}"
                                   FontWeight="Bold" Opacity="0.55" FontSize="11" CharacterSpacing="30"
                                   Visibility="{x:Bind ShowOriginatorLabel, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <svc:MarkdownPresenter Markdown="{x:Bind DisplayText, Mode=OneWay}" BaseFontSize="14"
                                   Collapsible="{x:Bind CollapseMessage, Mode=OneWay}"
                                   Visibility="{x:Bind DisplayText, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}"/>

                        <ContentControl ContentTemplate="{StaticResource ProgressSectionTemplate}" Content="{x:Bind}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Visibility="{x:Bind ShowProgressBlock, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"/>

                        <ContentControl ContentTemplate="{StaticResource PlanSectionTemplate}" Content="{x:Bind}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Visibility="{x:Bind ShowPlan, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"/>

                        <ContentControl ContentTemplate="{StaticResource FailedSectionTemplate}" Content="{x:Bind}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Visibility="{x:Bind SessionFailed, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}"/>

                        <ItemsControl ItemsSource="{x:Bind Artifacts, Mode=OneWay}" ItemTemplate="{StaticResource ArtifactsTemplate}" HorizontalContentAlignment="Stretch"
                                      Visibility="{x:Bind Artifacts, Converter={StaticResource CollectionToVisibilityConverter}, Mode=OneWay}"/>

                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1"
                                    Visibility="{x:Bind ChangeSummary, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}">
                            <FontIcon Glyph="&#xE70F;" FontSize="11" Opacity="0.6" VerticalAlignment="Top" Margin="0,3,0,0"/>
                            <svc:MarkdownPresenter Markdown="{x:Bind ChangeSummary, Mode=OneWay}" BaseFontSize="12" Opacity="0.85"/>
                        </StackPanel>

                        <TextBlock Text="{x:Bind CreateTime, Mode=OneWay, Converter={StaticResource DateTimeToTimeConverter}}" FontSize="11" HorizontalAlignment="Right" Opacity="0.4" Margin="0,2,0,0"
                                   Visibility="{x:Bind ShowTimestamp, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <ContentControl ContentTemplate="{StaticResource RawJsonTemplate}" Content="{x:Bind}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Visibility="{x:Bind ShowRawJson, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Body of a code review, shown inside a modal ContentDialog (see
             OnOpenReviewDialog) rather than an inline dropdown, so a long review
             never reflows the chat. -->
        <DataTemplate x:Key="ReviewDialogTemplate" x:DataType="models:Activity">
            <ScrollViewer MinWidth="460" MaxHeight="560" Padding="0,0,14,0"
                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <svc:MarkdownPresenter Markdown="{x:Bind ReviewDisplayText, Mode=OneWay}" BaseFontSize="13"
                               Visibility="{x:Bind ReviewDisplayText, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}"/>

                    <ItemsControl ItemsSource="{x:Bind Review.Comments, Mode=OneWay}" Visibility="{x:Bind Review.Comments, Converter={StaticResource CollectionToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ReviewComment">
                                <StackPanel Margin="0,3" Padding="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                                    <TextBlock FontWeight="SemiBold" FontSize="11" Opacity="0.75" TextWrapping="Wrap" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">
                                        <Run Text="{x:Bind FilePath}"/>
                                        <Run Text=" : "/>
                                        <Run Text="{x:Bind LineNumber}"/>
                                    </TextBlock>
                                    <svc:MarkdownPresenter Markdown="{x:Bind Comment}" BaseFontSize="12" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{x:Bind CreateTime, Mode=OneWay, Converter={StaticResource DateTimeToTimeConverter}}" FontSize="11" HorizontalAlignment="Right" Opacity="0.4"
                               Visibility="{x:Bind ShowTimestamp, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <ContentControl ContentTemplate="{StaticResource RawJsonTemplate}" Content="{x:Bind}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Visibility="{x:Bind ShowRawJson, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- Chat entry for a code review: a compact card that opens the review in
             a modal. -->
        <DataTemplate x:Key="CodeReviewTemplate" x:DataType="models:Activity">
            <Grid Margin="16,4" Visibility="{x:Bind HasContent, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                <Button Click="OnOpenReviewDialog" Tag="{x:Bind}"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                        MaxWidth="560" MinHeight="52" Padding="14,11" CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1"
                        ToolTipService.ToolTip="Open code review">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{ThemeResource AccentFillColorDefaultBrush}" Padding="8,3" CornerRadius="4" VerticalAlignment="Center">
                            <TextBlock Text="CODE REVIEW" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{x:Bind ReviewDisplayTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="15"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <FontIcon Grid.Column="2" Glyph="&#xE8A0;" FontSize="14" Opacity="0.6" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </Grid>
        </DataTemplate>

        <!-- Lifecycle events (plan approved, session completed, files changed): a centred status line with rules on each side -->
        <DataTemplate x:Key="SystemEventTemplate" x:DataType="models:Activity">
            <StackPanel Margin="24,10" Spacing="4">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Rectangle Grid.Column="0" Height="1" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind SystemEventText}" FontSize="12" FontWeight="SemiBold" Opacity="0.75" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind CreateTime, Mode=OneWay, Converter={StaticResource DateTimeToTimeConverter}}" FontSize="11" Opacity="0.4" VerticalAlignment="Center"
                                   Visibility="{x:Bind ShowTimestamp, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>

                    <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                </Grid>

                <ContentControl ContentTemplate="{StaticResource RawJsonTemplate}" Content="{x:Bind}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Visibility="{x:Bind ShowRawJson, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Stand-alone file-change note: "Updated `a` and `b`", left-aligned -->
        <DataTemplate x:Key="ChangeNoteTemplate" x:DataType="models:Activity">
            <Grid Margin="16,3">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE70F;" FontSize="11" Opacity="0.6" VerticalAlignment="Top" Margin="0,3,0,0"/>
                    <svc:MarkdownPresenter Markdown="{x:Bind ChangeSummary, Mode=OneWay}" BaseFontSize="12" Opacity="0.9"/>
                    <TextBlock Text="{x:Bind CreateTime, Mode=OneWay, Converter={StaticResource DateTimeToTimeConverter}}"
                               FontSize="11" Opacity="0.4" VerticalAlignment="Top" Margin="0,3,0,0"
                               Visibility="{x:Bind ShowTimestamp, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <svc:ChatActivityTemplateSelector x:Key="ChatActivityTemplateSelector"
            DefaultMessageTemplate="{StaticResource DefaultMessageTemplate}"
            CodeReviewTemplate="{StaticResource CodeReviewTemplate}"
            SystemEventTemplate="{StaticResource SystemEventTemplate}"
            ChangeNoteTemplate="{StaticResource ChangeNoteTemplate}"/>

        <!-- One line of a diff: old / new gutter, sign, code -->
        <DataTemplate x:Key="DiffLineTemplate" x:DataType="vm:DiffLineViewModel">
            <Grid Background="{x:Bind Type, Converter={StaticResource DiffLineTypeToColorConverter}}" MinHeight="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind OldGutter}" FontFamily="{x:Bind CodeFontFamily}" FontSize="{x:Bind FontSize}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="0,0,8,0" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock Grid.Column="1" Text="{x:Bind NewGutter}" FontFamily="{x:Bind CodeFontFamily}" FontSize="{x:Bind FontSize}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="0,0,8,0" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock Grid.Column="2" Text="{x:Bind Sign}" FontFamily="{x:Bind CodeFontFamily}" FontSize="{x:Bind FontSize}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{x:Bind Type, Converter={StaticResource DiffLineTypeToForegroundConverter}}"/>
                <TextBlock Grid.Column="3" Text="{x:Bind Content}" FontFamily="{x:Bind CodeFontFamily}" FontSize="{x:Bind FontSize}" TextWrapping="{x:Bind Wrapping}" VerticalAlignment="Center" Padding="4,0,16,0" Foreground="{x:Bind Type, Converter={StaticResource DiffLineTypeToForegroundConverter}}"/>
            </Grid>
        </DataTemplate>

        <!-- One hunk: a muted @@ header, then its lines -->
        <DataTemplate x:Key="DiffHunkTemplate" x:DataType="vm:DiffHunkViewModel">
            <StackPanel>
                <Border Background="{ThemeResource SubtleFillColorTertiaryBrush}" Padding="8,3" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,1">
                    <TextBlock Text="{x:Bind Header}" FontFamily="Consolas" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </Border>
                <ItemsControl ItemsSource="{x:Bind Lines}" ItemTemplate="{StaticResource DiffLineTemplate}"/>
            </StackPanel>
        </DataTemplate>

        <!-- One file: collapsible card with path + change badges -->
        <DataTemplate x:Key="DiffFileTemplate" x:DataType="vm:DiffFileViewModel">
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Margin="0,0,0,8" Padding="0"
                      svc:ScrollAnchor.PreserveOnResize="True"
                      IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                <Expander.Header>
                    <Grid ColumnSpacing="12" Padding="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7C3;" FontSize="13" Opacity="0.7"/>
                            <TextBlock Text="{x:Bind DisplayName}" FontFamily="Consolas" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind HunkCountLabel}" FontSize="11" Opacity="0.5" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind AddedBadge}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource DiffAddedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind RemovedBadge}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource DiffRemovedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                              VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                    <ItemsControl ItemsSource="{x:Bind Hunks}" ItemTemplate="{StaticResource DiffHunkTemplate}"/>
                </ScrollViewer>
            </Expander>
        </DataTemplate>

    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sessions List -->
        <Grid Grid.Column="0" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,1,0" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="16,16,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Sessions" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Command="{x:Bind ViewModel.RefreshAllDataCommand, Mode=OneWay}" ToolTipService.ToolTip="Refresh All (Clear Cache)" Background="Transparent" BorderThickness="0">
                    <SymbolIcon Symbol="Refresh"/>
                </Button>
            </Grid>

            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Sessions}"
                      SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="2,2,2,2"/>
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Session">
                        <Grid Padding="14,10" RowSpacing="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" FontSize="14"/>
                            <TextBlock Grid.Row="1" Text="{x:Bind Prompt, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" Opacity="0.6" FontSize="12"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Session Detail / Chat -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Select a session to start"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{x:Bind ViewModel.SelectedSession, Mode=OneWay, Converter={StaticResource InvertedNullToVisibilityConverter}}"
                       Style="{StaticResource TitleTextBlockStyle}"/>

            <Grid Grid.Row="0" Visibility="{x:Bind ViewModel.SelectedSession, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="16,8" ColumnSpacing="12"
                      Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.SelectedSession.Title, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"
                                   MaxLines="1" TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontSize="12" Opacity="0.6" MaxLines="1" TextTrimming="CharacterEllipsis"
                                   Visibility="{x:Bind ViewModel.SelectedSession.DisplayBranch, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                            <Run Text="⎇" FontFamily="Consolas"/>
                            <Run Text="{x:Bind ViewModel.SelectedSession.DisplayBranch, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="0,0,6,0"
                                    Visibility="{x:Bind ViewModel.StatusText, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                            <ProgressRing Width="14" Height="14"
                                          IsActive="{x:Bind ViewModel.StatusIsBusy, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.StatusIsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{x:Bind ViewModel.StatusKind, Mode=OneWay, Converter={StaticResource StatusKindToBrushConverter}}"
                                     Visibility="{x:Bind ViewModel.StatusIsBusy, Mode=OneWay, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{x:Bind ViewModel.StatusKind, Mode=OneWay, Converter={StaticResource StatusKindToBrushConverter}}"/>
                        </StackPanel>

                        <HyperlinkButton NavigateUri="{x:Bind ViewModel.SelectedSession.PrimaryPullRequest.Url, Mode=OneWay}"
                                         ToolTipService.ToolTip="{x:Bind ViewModel.SelectedSession.PrimaryPullRequest.Title, Mode=OneWay}"
                                         Padding="8,4"
                                         Visibility="{x:Bind ViewModel.SelectedSession.PrimaryPullRequest, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE8A7;" FontSize="12"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedSession.PullRequestLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </HyperlinkButton>

                        <Button Content="Approve Plan"
                                Visibility="{x:Bind ViewModel.SelectedSession.PendingPlan, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"
                                Command="{x:Bind ViewModel.ApprovePlanCommand}"
                                Style="{StaticResource AccentButtonStyle}"/>
                        <HyperlinkButton NavigateUri="{x:Bind ViewModel.SelectedSession.Url, Mode=OneWay}"
                                         ToolTipService.ToolTip="Open this session on jules.google.com (to pause, cancel, etc.)"
                                         Padding="8,4"
                                         Visibility="{x:Bind ViewModel.SelectedSession.Url, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE774;" FontSize="12"/>
                                <TextBlock Text="Open in Jules" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </HyperlinkButton>
                        <Button Command="{x:Bind ViewModel.CopySessionJsonCommand}"
                                ToolTipService.ToolTip="Copy session JSON"
                                Background="Transparent" BorderThickness="0" Padding="6">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="12,4" ColumnSpacing="12"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <SelectorBar x:Name="ChatDiffSelector" VerticalAlignment="Center"
                                     SelectionChanged="OnChatDiffSelectionChanged">
                            <SelectorBarItem x:Name="ChatTabItem" Text="Chat" IsSelected="True"/>
                            <SelectorBarItem x:Name="DiffTabItem" Text="Diff"/>
                        </SelectorBar>

                        <!-- Right side of the tab bar: at-a-glance change stats -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.AggregatePatch, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{x:Bind ViewModel.DiffSummary, Mode=OneWay}" FontSize="12" Opacity="0.65" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.DiffAddedLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource DiffAddedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.DiffRemovedLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource DiffRemovedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListView x:Name="ChatListView"
                                  Loaded="OnChatListLoaded"
                                  ItemsSource="{x:Bind ViewModel.Activities}"
                                  SelectionMode="None"
                                  Padding="0,10,0,20"
                                  ItemTemplateSelector="{StaticResource ChatActivityTemplateSelector}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <Grid x:Name="DiffPanel" Visibility="Collapsed" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                            <ScrollViewer Padding="12">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.DiffFiles}" ItemTemplate="{StaticResource DiffFileTemplate}"/>
                            </ScrollViewer>
                        </Grid>

                        <!-- Floating "jump to latest" affordance, shown when the chat is scrolled up.
                             Kept visible but at Opacity 0 / non-hit-testable when hidden so the
                             OpacityTransition can fade it in and out instead of it popping. -->
                        <Button x:Name="JumpToBottomButton" Click="OnJumpToBottomClick"
                                Opacity="0" IsHitTestVisible="False"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,20,16" Width="36" Height="36" Padding="0"
                                CornerRadius="18"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource AccentFillColorTertiaryBrush}"
                                ToolTipService.ToolTip="Jump to latest">
                            <Button.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.16"/>
                            </Button.OpacityTransition>
                            <FontIcon Glyph="&#xE70D;" FontSize="14" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Chat Input -->
            <Grid Grid.Row="1" Padding="16" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                  Visibility="{x:Bind ViewModel.SelectedSession, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="ChatInputBox" PlaceholderText="Message Jules..."
                         Text="{x:Bind ViewModel.ChatInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" MaxHeight="120"
                         CornerRadius="8"
                         PreviewKeyDown="OnChatInputPreviewKeyDown"/>
                <Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.SendMessageCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Send"/>
                        <TextBlock Text="Send"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Page>
